# Copier vers .env (local) ou secrets CI — NE PAS COMMITTER

# Public (injectées au build Eleventy / assets JS — OK côté client)
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJ...

# Edge Functions uniquement (Supabase dashboard → Edge Functions secrets)
SUPABASE_SERVICE_ROLE_KEY=eyJ...
MARKETPLACE_ADMIN_BOOTSTRAP_SECRET=long-random-string-for-one-time-admin
MARKETPLACE_INTERNAL_SECRET=long-random-string-edge-to-edge

# Email transactionnel (Supabase Auth SMTP ou Resend — config dashboard)
# SMTP_HOST=
# SMTP_USER=
# SMTP_PASS=

# Antibot (optionnel)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Monétisation future (désactivé au lancement)
MARKETPLACE_PUBLISHING_FEE_ENABLED=false

# Webhook GitHub : regénérer pages SEO statiques à la publication (optionnel)
GITHUB_DISPATCH_TOKEN=
GITHUB_REPO=Phantom942/REDK-MOTORS
