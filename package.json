{
  "name": "redk-motors",
  "version": "2.0.0",
  "description": "Site garage RED-K MOTORS - Ivry-sur-Seine",
  "scripts": {
    "check:hours": "node scripts/check-hours.js",
    "build": "npm run check:hours && node scripts/sync-google-reviews.js && node scripts/bundle-marketplace.mjs && node -e \"require('fs').rmSync('_site',{recursive:true,force:true});\" && eleventy && node scripts/generate-legacy-redirects.js && node scripts/minify.js",
    "google:reviews": "node scripts/sync-google-reviews.js",
    "serve": "eleventy --serve",
    "dev": "eleventy --serve",
    "dev:marketplace-local": "node scripts/marketplace-dev-serve.mjs",
    "fonts:setup": "node scripts/setup-local-fonts.js",
    "logo:webp": "node scripts/generate-logo-webp.js",
    "favicon": "node scripts/generate-favicons.js",
    "og-image": "node scripts/generate-og-image.js",
    "google:place-id": "node scripts/resolve-google-place-id.js",
    "videos:optimize": "node scripts/optimize-videos.js",
    "indexnow:ping": "node scripts/indexnow-ping.js",
    "indexnow:priority": "node scripts/indexnow-priority.js",
    "redirects:export-me": "node scripts/export-cloudflare-me-redirects.js",
    "redirects:kv-shards": "node scripts/generate-kv-redirect-shards.js",
    "audit:blog": "node scripts/audit-blog-seo.js && node scripts/audit-blog-geo.js",
    "audit:sitemap": "node scripts/audit-sitemap.js",
    "blog:refresh": "node scripts/refresh-blog-freshness.js",
    "audit:exemples": "node scripts/audit-exemples.js",
    "audit:code": "node scripts/audit-code.js",
    "verify:prod": "node scripts/verify-prod-headers.js",
    "post-deploy": "node scripts/post-deploy.js",
    "cf:deploy-headers": "node scripts/deploy-kv-worker-headers.js",
    "test:marketplace-security": "node scripts/marketplace-security-test.mjs",
    "test:marketplace-live": "node scripts/marketplace-security-live.mjs",
    "test:marketplace:local-reset": "node scripts/marketplace-local-reset.mjs",
    "test:marketplace:local-seed": "node scripts/marketplace-local-seed.mjs",
    "test:marketplace:e2e": "node scripts/marketplace-e2e.mjs",
    "test:marketplace:e2e:extended": "node scripts/marketplace-e2e-extended.mjs",
    "test:marketplace:e2e:admin": "node scripts/marketplace-e2e-admin.mjs",
    "test:marketplace:moderation-regression": "node scripts/marketplace-moderation-action-regression.mjs",
    "test:marketplace:e2e:concurrency": "node scripts/marketplace-e2e-concurrency.mjs",
    "test:marketplace:local": "node scripts/marketplace-run-local-validation.mjs",
    "test:marketplace:preprod": "node scripts/marketplace-preprod-smoke.mjs",
    "marketplace:functions": "node scripts/marketplace-functions-serve.mjs",
    "marketplace:sitemap": "node scripts/generate-marketplace-sitemap.mjs",
    "bundle:marketplace": "node scripts/bundle-marketplace.mjs",
    "test:marketplace:ssr": "node scripts/marketplace-ssr-states.mjs"
  },
  "keywords": [
    "eleventy",
    "static-site",
    "garage"
  ],
  "author": "RED-K MOTORS",
  "license": "UNLICENSED",
  "devDependencies": {
    "@supabase/supabase-js": "2.49.1",
    "@11ty/eleventy": "^3.0.0",
    "esbuild": "^0.25.0",
    "@fontsource/manrope": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "clean-css": "^5.3.3",
    "sharp": "^0.35.4",
    "sharp-ico": "^0.1.5"
  }
}
