{
  "name": "redk-motors",
  "version": "2.0.0",
  "description": "Site garage RED-K MOTORS - Ivry-sur-Seine",
  "scripts": {
    "check:hours": "node scripts/check-hours.js",
    "build": "npm run check:hours && node scripts/sync-google-reviews.js && node -e \"require('fs').rmSync('_site',{recursive:true,force:true});\" && eleventy && node scripts/generate-legacy-redirects.js && node scripts/minify.js",
    "google:reviews": "node scripts/sync-google-reviews.js",
    "serve": "eleventy --serve",
    "dev": "eleventy --serve",
    "fonts:setup": "node scripts/setup-local-fonts.js",
    "logo:webp": "node scripts/generate-logo-webp.js",
    "favicon": "node scripts/generate-favicons.js",
    "og-image": "node scripts/generate-og-image.js",
    "google:place-id": "node scripts/resolve-google-place-id.js",
    "videos:optimize": "node scripts/optimize-videos.js",
    "indexnow:ping": "node scripts/indexnow-ping.js",
    "indexnow:priority": "node scripts/indexnow-priority.js",
    "redirects:export-me": "node scripts/export-cloudflare-me-redirects.js",
    "redirects:kv-shards": "node scripts/generate-kv-redirect-shards.js",
    "redirects:kv-backup": "node scripts/deploy-kv-shards.js --backup-only --dir workers/kv-backup",
    "redirects:kv-upload": "node scripts/deploy-kv-shards.js --upload-only",
    "redirects:kv-restore": "node scripts/deploy-kv-shards.js --restore --dir workers/kv-backup",
    "redirects:kv-deploy": "node scripts/deploy-kv-wrangler.js",
    "test:blog-migration": "node scripts/test-blog-migration-redirects.js",
    "test:conversion-tracking": "node scripts/test-conversion-tracking.js",
    "test:conversion-browser": "node scripts/test-conversion-browser.mjs",
    "test:sync-reviews": "node scripts/test-sync-google-reviews.js",
    "test:gtm-pageview": "node scripts/test-gtm-pageview.mjs",
    "audit:schema": "node scripts/audit-schema-types.js",
    "test:kv-restore": "node scripts/test-kv-shards-restore.js",
    "verify:blog-redirects:prod": "node scripts/verify-blog-redirects-prod.js --strict",
    "verify:blog-redirects:prod:all": "node scripts/verify-blog-redirects-prod.js --all --strict",
    "audit:blog": "node scripts/audit-blog-seo.js && node scripts/audit-blog-geo.js",
    "audit:sitemap": "node scripts/audit-sitemap.js",
    "blog:refresh": "node scripts/refresh-blog-freshness.js",
    "audit:exemples": "node scripts/audit-exemples.js",
    "audit:links": "node scripts/audit-internal-links.js",
    "audit:gsc-top": "node scripts/audit-gsc-top-links.js",
    "audit:code": "node scripts/audit-code.js",
    "audit:google-reviews": "node scripts/audit-google-reviews-consistency.js",
    "verify:prod": "node scripts/verify-prod-headers.js",
    "post-deploy": "node scripts/post-deploy.js",
    "ops:check": "node scripts/verify-ops-readiness.js",
    "ops:report": "node scripts/ops-build-report.js",
    "cf:deploy-headers": "node scripts/deploy-kv-worker-headers.js"
  },
  "keywords": [
    "eleventy",
    "static-site",
    "garage"
  ],
  "author": "RED-K MOTORS",
  "license": "UNLICENSED",
  "devDependencies": {
    "@11ty/eleventy": "^3.1.6",
    "@fontsource/manrope": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "clean-css": "^5.3.3",
    "playwright": "^1.64.1",
    "sharp": "^0.35.4",
    "sharp-ico": "^0.1.5"
  }
}
