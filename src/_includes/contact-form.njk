{# Formulaires retirés — contact par téléphone / WhatsApp uniquement #}
<section class="contact-form-section contact-form-section--call" aria-labelledby="contact-call-title" data-animate="slide-up">
  <div class="container contact-form-section__inner">
    <div class="contact-form-section__intro">
      <p class="section-kicker">Contact</p>
      <h2 id="contact-call-title">Appelez pour un RDV ou un devis</h2>
      <p>Pas de formulaire en ligne — on préfère vous répondre directement. En journée (lun–sam, 9h–19h), le téléphone est le plus rapide. WhatsApp pour envoyer des photos.</p>
    </div>
    <div class="contact-form__actions contact-form__actions--call">
      <a class="btn btn--primary contact-form__submit" href="tel:{{ site.phone }}" data-track="click_call" data-track-pos="contact_call_block">
        Appeler {{ site.phoneDisplayCompact | default(site.phoneDisplay) }}
      </a>
      <a class="btn btn--secondary" href="{{ site.whatsappUrl }}" target="_blank" rel="noopener noreferrer" data-track="click_whatsapp" data-track-pos="contact_call_block">
        WhatsApp
      </a>
      <p class="contact-form__alt">Ou écrivez à <a href="mailto:{{ site.email }}">{{ site.email }}</a>.</p>
    </div>
  </div>
</section>
