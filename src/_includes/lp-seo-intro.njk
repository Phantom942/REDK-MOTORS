{% if lp.seoParagraphs and lp.seoParagraphs.length %}
<section class="service-focus service-focus--compact" aria-labelledby="{{ lpId }}-seo-text">
  <div class="container service-focus__inner">
    <div>
      {% if lp.seoTitle %}
      <h2 id="{{ lpId }}-seo-text">{{ lp.seoTitle }}</h2>
      {% endif %}
      {% for paragraph in lp.seoParagraphs %}
      <p>{{ paragraph }}</p>
      {% endfor %}
      {% if lp.seoProblems and lp.seoProblems.length %}
      {% set problemLinks = lp.seoProblems | evenItems %}
      {% if problemLinks.length %}
      <h3 class="service-focus__subhead">Problèmes fréquents traités en atelier</h3>
      <ul class="service-focus__problem-list">
        {% for problem in problemLinks %}
        <li>
          {% if problem.url %}
          <a href="{{ problem.url }}" class="service-focus__problem-link">{{ problem.text }}</a>
          {% else %}
          <span class="service-focus__problem-link service-focus__problem-link--text">{{ problem.text }}</span>
          {% endif %}
        </li>
        {% endfor %}
      </ul>
      {% endif %}
      {% endif %}
    </div>
  </div>
</section>
{% endif %}
