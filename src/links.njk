<section class="link-hub" aria-labelledby="link-hub-title">
  {# Ciel étoilé + météores (même stack que phantomdev.fr / CodePen Delroy Prithvi MIT) #}
  <div class="link-hub__sky" aria-hidden="true">
    <div class="link-hub__sky-base"></div>
    <div class="link-hub__halo"></div>
    <div class="link-hub__stars-field">
      {% for star in linkHubStars %}
      <span
        class="link-hub__static-star{% if star.glow %} link-hub__static-star--glow{% endif %}"
        style="left:{{ star.left }}%;top:{{ star.top }}%;width:{{ star.size }}px;height:{{ star.size }}px;--star-opacity:{{ star.opacity }};animation-duration:{{ star.duration }}s;animation-delay:{{ star.delay }}s"
      ></span>
      {% endfor %}
    </div>
    <div class="link-hub__meteors">
      <span></span><span></span><span></span><span></span><span></span>
      <span></span><span></span><span></span><span></span><span></span>
    </div>
  </div>
  <div class="link-hub__inner">
    <header class="link-hub__header">
      <img
        class="link-hub__avatar"
        src="{{ '/assets/img/logo-basique-carre.png' | cacheBust }}"
        alt="Logo RED-K MOTORS — garage automobile à Ivry-sur-Seine"
        width="96"
        height="96"
        decoding="async"
        fetchpriority="high"
      />
      <h1 id="link-hub-title" class="link-hub__title">{{ site.name }}</h1>
      <p class="link-hub__handle">@redkmotors</p>
      <p class="link-hub__bio">Garage Ivry-sur-Seine (94) · Mar–sam 9h–19h<br />{{ site.googleReviews.rating | googleRatingDisplay }} ★ · {{ site.googleReviews.count }} avis Google</p>
    </header>

    <ul class="link-hub__list">
      {% for item in linkHub.actions %}
      <li>
        <a
          class="link-hub__btn{% if item.id == 'whatsapp' %} link-hub__btn--featured{% endif %}"
          href="{{ hubHref(item) | trim }}"
          {% if item.external %}target="_blank" rel="noopener noreferrer"{% endif %}
          data-track="{{ item.track }}"
          data-track-pos="{{ item.trackPos }}"
        >
          {{ hubIcon(item.icon) }}
          <span class="link-hub__btn-label">{{ item.label }}</span>
        </a>
      </li>
      {% endfor %}
    </ul>

    <nav class="link-hub__socials" aria-label="Réseaux sociaux">
      {% for item in linkHub.social %}
      <a
        class="link-hub__social"
        href="{{ hubHref(item) | trim }}"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="{{ item.label }}"
        data-track="{{ item.track }}"
        data-track-pos="{{ item.trackPos }}"
      >
        {{ hubIcon(item.icon) }}
      </a>
      {% endfor %}
    </nav>
  </div>
</section>
