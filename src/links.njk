{%- elif item.hrefKey == "googleReviewsMaps" -%}{{ site.googleReviews.mapsPlaceUrl }}
{%- elif item.hrefKey == "instagramUrl" -%}{{ site.social.instagramUrl }}
{%- elif item.hrefKey == "tiktokUrl" -%}{{ site.social.tiktokUrl }}
{%- elif item.hrefKey == "facebookUrl" -%}{{ site.social.facebookUrl }}
{%- elif item.hrefKey == "youtubeUrl" -%}{{ site.social.youtubeUrl }}
{%- elif item.hrefKey == "snapchatUrl" -%}{{ site.social.snapchatUrl }}
{%- endif -%}
{%- endmacro -%}

