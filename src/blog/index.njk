---
layout: base.njk
title: "Blog | Conseils auto, entretien et mécanique | RED-K MOTORS"
description: "Conseils et actualités du garage RED-K MOTORS à Ivry-sur-Seine. Entretien, mécanique, carrosserie, pneumatiques — tous nos articles pour prendre soin de votre véhicule."
pageKey: blog
pagination:
  data: collections.blog
  size: 20
  reverse: true
eleventyComputed:
  title: "{% if pagination.pageNumber > 0 %}Blog — page {{ pagination.pageNumber + 1 }} | Conseils auto | RED-K MOTORS{% else %}Blog | Conseils auto, entretien et mécanique | RED-K MOTORS{% endif %}"
  description: "{% if pagination.pageNumber > 0 %}Page {{ pagination.pageNumber + 1 }} du blog RED-K MOTORS — conseils auto, entretien et mécanique à Ivry-sur-Seine.{% else %}Conseils et actualités du garage RED-K MOTORS à Ivry-sur-Seine. Entretien, mécanique, carrosserie, pneumatiques — tous nos articles pour prendre soin de votre véhicule.{% endif %}"
  robots: "{% if pagination.pageNumber > 0 %}noindex, follow{% else %}index, follow{% endif %}"
  canonicalPath: "{% if pagination.pageNumber > 0 %}/blog/{% else %}{{ page.url }}{% endif %}"
breadcrumb:
  "@context": "https://schema.org"
  "@type": "BreadcrumbList"
  itemListElement:
    - "@type": "ListItem"
      position: 1
      name: "Accueil"
      item: "https://redkmotors.fr/"
    - "@type": "ListItem"
      position: 2
      name: "Blog"
      item: "https://redkmotors.fr/blog/"
permalink: /blog/{% if pagination.pageNumber > 0 %}page/{{ pagination.pageNumber }}/{% endif %}index.html
---

<section class="blog-index" aria-labelledby="blog-title">
  <div class="container">
    <nav class="breadcrumb" aria-label="Fil d'Ariane">
      <ol>
        <li><a href="/">Accueil</a></li>
        <li aria-current="page">Blog</li>
      </ol>
    </nav>
    <header class="blog-index__header">
      <h1 id="blog-title">Blog conseils auto</h1>
      <p>Entretien, mécanique, freinage, carrosserie et diagnostic : guides pratiques par l'équipe RED-K MOTORS à Ivry-sur-Seine (94).</p>
    </header>

    {% include "blog-filters.njk" %}

    <ol class="blog-list">
      {% for post in pagination.items %}
      <li class="blog-list__item">
        <article class="blog-card">
          <div class="blog-card__body">
            <div class="blog-card__meta">
              {% if post.data.category %}<span class="blog-card__category">{{ post.data.category }}</span>{% endif %}
              <time datetime="{{ post.data.date }}">{{ post.data.dateDisplay or post.data.date }}</time>
            </div>
            <h2 class="blog-card__title">
              <a href="{{ post.url }}">{{ post.data.title | replace(" | Blog RED-K MOTORS", "") | replace(" | RED-K MOTORS", "") | replace(" | Garage Ivry (94)", "") | replace(" | Garage Ivry", "") }}</a>
            </h2>
            <p class="blog-card__excerpt">{{ post.data.excerpt }}</p>
            <a href="{{ post.url }}" class="blog-card__link">Lire l'article →</a>
          </div>
        </article>
      </li>
      {% endfor %}
    </ol>

    {% if pagination.pages.length > 1 %}
    <nav class="blog-pagination" aria-label="Pagination des articles">
      <ul>
        {% if pagination.previousPageHref %}
        <li><a href="{{ pagination.previousPageHref }}">← Articles plus récents</a></li>
        {% endif %}
        {% if pagination.nextPageHref %}
        <li><a href="{{ pagination.nextPageHref }}">Articles plus anciens →</a></li>
        {% endif %}
      </ul>
    </nav>
    {% endif %}
  </div>
</section>

{% set lpId = pageKey %}
{% include "lp-related-services.njk" %}
